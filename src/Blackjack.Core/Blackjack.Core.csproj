<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.1 + C# 9 es el máximo que Unity 6 puede consumir como DLL
      precompilada. No subir esto sin comprobar el cliente: si se rompe,
      el motor deja de compartirse y hay que duplicar las reglas.
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Blackjack.Core</RootNamespace>
    <AssemblyName>Blackjack.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blackjack.Core.Tests" />
  </ItemGroup>

</Project>
