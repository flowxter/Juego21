<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.1 igual que Core: el cliente Unity importa ambos como DLL
      y así comparte los contratos en vez de reescribirlos a mano.
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Blackjack.Protocol</RootNamespace>
    <AssemblyName>Blackjack.Protocol</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blackjack.Core\Blackjack.Core.csproj" />
  </ItemGroup>

</Project>
